rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isSuperAdmin() {
      return signedIn() && email() == 'rjbelaire@gmail.com';
    }

    // cga/users.adminEmails is written beside the existing list. Missing field denies.
    function isListedAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/cga/users)
        && 'adminEmails' in get(/databases/$(database)/documents/cga/users).data
        && email().lower() in get(/databases/$(database)/documents/cga/users).data.adminEmails;
    }

    function hasProfileAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }

    function isAdmin() {
      return isSuperAdmin() || isListedAdmin() || hasProfileAdmin();
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /savedFilters/{docId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if ownsExisting();
    }

    match /savedViews/{docId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if ownsExisting();
    }

    match /favorites/{docId} {
      allow create: if ownsIncoming();
      allow read, update, delete: if ownsExisting();
    }

    // Public club records. Operational money and draft scores are admin-only.
    match /cga/{docId} {
      allow read: if docId in [
        'members', 'standings', 'poy', 'ptm', 'beginningOfYearPtm', 'tournamentStatus'
      ] || isAdmin();
      allow write: if isAdmin();
    }

    match /cgaResults/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cgaPairings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cgaLifecycle/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cgaScores/{docId} {
      allow read, write: if isAdmin();
    }

    match /cgaPayments/{docId} {
      allow read, write: if isAdmin();
    }

    match /cgaPaymentMeta/{docId} {
      allow read, write: if isAdmin();
    }

    match /cgaSnapshots/{docId} {
      allow read, write: if isAdmin();
    }

    // New log entries are their own documents. The old array docs are still read.
    match /cgaChangelog/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /cgaCreditTx/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
