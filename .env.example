# Firebase project credentials
# Copy this file to .env.local and fill in your values.
# Get these from: Firebase Console → Project Settings → Web App → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Admin auth
# Single PIN (legacy): VITE_ADMIN_PIN=cga2026
# Multi-PIN (JSON object mapping pin → display name):
# VITE_ADMIN_PINS={"cga2026":"Admin","5678":"Scott","9012":"Mike"}
